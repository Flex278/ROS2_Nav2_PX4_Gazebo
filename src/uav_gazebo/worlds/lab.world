<?xml version="1.0" ?>
<!-- Мир-лаборатория UAV.
     Оптимизирован под GTX 1050: тени отключены, физика настроена явно. -->
<sdf version="1.9">
  <world name="lab">

    <!-- ============ ФИЗИКА (настройка под слабое железо) ============ -->
    <!-- type="ignored" отключал физику -> IMU не публиковался -> EKF2 "missing data".
         Используем ODE (как в default.sdf PX4), чтобы дрон и сенсоры работали. -->
    <physics name="default" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>

    <!-- Магнитное поле Земли (как в default.sdf PX4) — нужно для компаса
         sensor_mag_sim, иначе Preflight "Compass Sensor 0 missing". -->
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- ============ СЦЕНА (тёмный фон, тени выключены) ============ -->
    <scene>
      <ambient>0.55 0.55 0.6</ambient>
      <background>0.53 0.81 0.92</background>
      <sky>
        <time>10.0</time>
      </sky>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <direction>0.3 0.4 -1</direction>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- ============ ЗЕМЛЯ: зелёная «трава» ============ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>40 40</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.45 0.18 1</ambient>
            <diffuse>0.3 0.55 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ ВЗЛЁТНО-ПОСАДОЧНЫЕ ПЛОЩАДКИ ============ -->
    <!-- Стартовая площадка (точка взлёта) -->
    <model name="pad_start">
      <static>true</static>
      <pose>0 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.9</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.35 0.05 1</ambient>
            <diffuse>0.95 0.4 0.05 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- Площадка у цели Nav2 (x=3) -->
    <model name="pad_goal">
      <static>true</static>
      <pose>3 0 0.01 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.9</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.35 0.05 1</ambient>
            <diffuse>0.95 0.4 0.05 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ ЦВЕТНЫЕ ОРИЕНТИРЫ (для восприятия движения) ============ -->
    <model name="landmark_blue">
      <static>true</static>
      <pose>-1.5 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.3 0.8 1</ambient>
            <diffuse>0.2 0.5 0.95 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="landmark_yellow">
      <static>true</static>
      <pose>6 2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.8 0.7 0.1 1</ambient>
            <diffuse>0.9 0.8 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <model name="landmark_green">
      <static>true</static>
      <pose>1.5 -2.5 0.5 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1</length>
            </cylinder>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.15</radius>
              <length>1</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.1 0.7 0.3 1</ambient>
            <diffuse>0.2 0.8 0.4 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ СТЕНА-ПРЕПЯТСТВИЕ (тест Nav2) ============ -->
    <model name="wall">
      <static>true</static>
      <pose>5 0 1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>0.2 4 2</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>0.2 4 2</size>
            </box>
          </geometry>
          <material>
            <ambient>0.5 0.2 0.2 1</ambient>
            <diffuse>0.5 0.2 0.2 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ H-МАРКЕР (точная посадка, CV) ============ -->
    <include>
      <uri>model://h_marker</uri>
      <pose>2 2 0 0 0 0</pose>
    </include>


    <!-- ============ СФЕРИЧЕСКИЕ КООРДИНАТЫ (для NavSat / GPS) ============ -->
    <!-- Без этого блока Gazebo NavSat не пересчитывает lat/lon/alt из позиции
         модели, и GPS-высота замирает на значении позы сенсора -> EKF2 высоты
         деградирует, и дрон безостановочно набирает высоту. Значения как в
         default.sdf PX4. -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

  </world>
</sdf>
