<?xml version="1.0" ?>
<!-- Мир «street»: дорога с разметкой вдоль X, пешеходный переход («зебра») на x=+10,
     тротуары, 4 фонарных столба (2+2), знак «стоп», светофор, пешеход, 3 машины разных цветов,
     конусы. Высокие объекты (столбы/светофор, >=2 м) попадают в /scan — Nav2 обходит;
     низкие (машины/пешеход/конусы/знак, <2 м) — визуальные CV-цели.
     Оптимизирован под слабое железо: тени выключены, сплошные цвета, без текстур. -->
<sdf version="1.9">
  <world name="street">

    <!-- ============ ФИЗИКА (настройка под слабое железо) ============ -->
    <physics name="default" type="ode">
      <max_step_size>0.004</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>250</real_time_update_rate>
    </physics>
    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system"/>
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system"/>
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system"/>
    <plugin name="gz::sim::systems::Contact" filename="gz-sim-contact-system"/>
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system"/>
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system"/>
    <plugin name="gz::sim::systems::AirPressure" filename="gz-sim-air-pressure-system"/>
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system"/>
    <plugin name="gz::sim::systems::Magnetometer" filename="gz-sim-magnetometer-system"/>

    <!-- Магнитное поле Земли (для компаса sensor_mag_sim). -->
    <magnetic_field>6e-06 2.3e-05 -4.2e-05</magnetic_field>

    <!-- ============ СЦЕНА (голубой фон, тени выключены) ============ -->
    <scene>
      <ambient>0.55 0.55 0.6</ambient>
      <background>0.53 0.81 0.92</background>
      <shadows>false</shadows>
      <grid>false</grid>
    </scene>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <direction>0.3 0.4 -1</direction>
      <diffuse>0.9 0.9 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
    </light>

    <!-- ============ ЗЕМЛЯ: зелёная «трава» ============ -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>80 80</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.2 0.45 0.18 1</ambient>
            <diffuse>0.3 0.55 0.22 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ ДОРОГА: асфальт 50 x 7 м, вдоль X (x от -15 до +35) ============ -->
    <model name="road">
      <static>true</static>
      <pose>10 0 0.02 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>50 7 0.04</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>50 7 0.04</size></box></geometry>
          <material>
            <ambient>0.12 0.12 0.13 1</ambient>
            <diffuse>0.25 0.25 0.27 1</diffuse>
            <specular>0.05 0.05 0.05 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ ТРОТУАРЫ (по бокам дороги, 50 x 1.5 м, y=±4.25) ============ -->
    <model name="sidewalk_right">
      <static>true</static>
      <pose>10 4.25 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>50 1.5 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>50 1.5 0.2</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.37 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>
    <model name="sidewalk_left">
      <static>true</static>
      <pose>10 -4.25 0.1 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry><box><size>50 1.5 0.2</size></box></geometry>
        </collision>
        <visual name="visual">
          <geometry><box><size>50 1.5 0.2</size></box></geometry>
          <material>
            <ambient>0.35 0.35 0.37 1</ambient>
            <diffuse>0.55 0.55 0.58 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ СТАРТОВАЯ ПЛОЩАДКА (точка взлёта) ============ -->
    <model name="pad_start">
      <static>true</static>
      <pose>0 0 0.05 0 0 0</pose>
      <link name="link">
        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.9</radius>
              <length>0.02</length>
            </cylinder>
          </geometry>
          <material>
            <ambient>0.9 0.35 0.05 1</ambient>
            <diffuse>0.95 0.4 0.05 1</diffuse>
            <specular>0.2 0.2 0.2 1</specular>
          </material>
        </visual>
      </link>
    </model>

    <!-- ============ РАЗМЕТКА (белая, только визуал; один link = много visual) ============ -->
    <model name="road_markings">
      <static>true</static>
      <link name="link">

        <!-- Осевая прерывистая (8 штрихов по 3 м, шаг 6 м) -->
        <visual name="dash_m12"><pose>-12 0 0.043 0 0 0</pose><geometry><box><size>3 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="dash_m6"><pose>-6 0 0.043 0 0 0</pose><geometry><box><size>3 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="dash_0"><pose>0 0 0.043 0 0 0</pose><geometry><box><size>3 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="dash_6"><pose>6 0 0.043 0 0 0</pose><geometry><box><size>3 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="dash_12"><pose>12 0 0.043 0 0 0</pose><geometry><box><size>3 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="dash_18"><pose>18 0 0.043 0 0 0</pose><geometry><box><size>3 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="dash_24"><pose>24 0 0.043 0 0 0</pose><geometry><box><size>3 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="dash_30"><pose>30 0 0.043 0 0 0</pose><geometry><box><size>3 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>

        <!-- Краевые сплошные линии -->
        <visual name="edge_right"><pose>10 3.25 0.043 0 0 0</pose><geometry><box><size>50 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="edge_left"><pose>10 -3.25 0.043 0 0 0</pose><geometry><box><size>50 0.15 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>

        <!-- Пешеходный переход («зебра») на x=+10: 7 полос 0.4 x 6.5 м -->
        <visual name="zebra_1"><pose>7.6 0 0.043 0 0 0</pose><geometry><box><size>0.4 6.5 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="zebra_2"><pose>8.4 0 0.043 0 0 0</pose><geometry><box><size>0.4 6.5 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="zebra_3"><pose>9.2 0 0.043 0 0 0</pose><geometry><box><size>0.4 6.5 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="zebra_4"><pose>10.0 0 0.043 0 0 0</pose><geometry><box><size>0.4 6.5 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="zebra_5"><pose>10.8 0 0.043 0 0 0</pose><geometry><box><size>0.4 6.5 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="zebra_6"><pose>11.6 0 0.043 0 0 0</pose><geometry><box><size>0.4 6.5 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>
        <visual name="zebra_7"><pose>12.4 0 0.043 0 0 0</pose><geometry><box><size>0.4 6.5 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>

        <!-- Стоп-линия перед переходом -->
        <visual name="stop_line"><pose>6.5 0 0.043 0 0 0</pose><geometry><box><size>0.5 6.5 0.005</size></box></geometry><material><ambient>0.9 0.9 0.9 1</ambient><diffuse>1 1 1 1</diffuse></material></visual>

      </link>
    </model>

    <!-- ============ ФОНАРИ: 2+2 (на тротуарах, y=±4.25) ============ -->
    <include><uri>model://street_light</uri><name>street_light_1</name><pose>0 4.25 0.2 0 0 0</pose></include>
    <include><uri>model://street_light</uri><name>street_light_2</name><pose>20 4.25 0.2 0 0 0</pose></include>
    <include><uri>model://street_light</uri><name>street_light_3</name><pose>0 -4.25 0.2 0 0 0</pose></include>
    <include><uri>model://street_light</uri><name>street_light_4</name><pose>20 -4.25 0.2 0 0 0</pose></include>

    <!-- ============ ЗНАК «СТОП» и СВЕТОФОР (правый тротуар) ============ -->
    <include><uri>model://stop_sign</uri><name>stop_sign</name><pose>6 4.25 0.2 0 0 0</pose></include>
    <include><uri>model://traffic_light</uri><name>traffic_light</name><pose>10 4.25 0.2 0 0 0</pose></include>

    <!-- ============ ПЕШЕХОД (правый тротуар у перехода) ============ -->
    <include><uri>model://pedestrian</uri><name>pedestrian</name><pose>10 3.7 0.2 0 0 0</pose></include>

    <!-- ============ 3 МАШИНЫ (припаркованы у обочины, разных цветов) ============ -->
    <include><uri>model://car_blue</uri><name>car_parked_1</name><pose>0 2.6 0.04 0 0 0</pose></include>
    <include><uri>model://car_green</uri><name>car_parked_2</name><pose>15 -2.6 0.04 0 0 3.14159</pose></include>
    <include><uri>model://car_red</uri><name>car_parked_3</name><pose>25 2.6 0.04 0 0 0</pose></include>

    <!-- ============ КОНУСЫ (у перехода) ============ -->
    <include><uri>model://traffic_cone</uri><name>cone_1</name><pose>8.5 2.5 0.04 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_2</name><pose>11.5 2.5 0.04 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_3</name><pose>8.5 -2.5 0.04 0 0 0</pose></include>
    <include><uri>model://traffic_cone</uri><name>cone_4</name><pose>11.5 -2.5 0.04 0 0 0</pose></include>

    <!-- ============ СФЕРИЧЕСКИЕ КООРДИНАТЫ (для NavSat / GPS) ============ -->
    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <world_frame_orientation>ENU</world_frame_orientation>
      <latitude_deg>47.397971057728974</latitude_deg>
      <longitude_deg>8.546163739800146</longitude_deg>
      <elevation>0</elevation>
    </spherical_coordinates>

  </world>
</sdf>
