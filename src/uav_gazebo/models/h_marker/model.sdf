<?xml version="1.0" ?>
<!-- Плоский H-маркер для отработки точной посадки (детекция через OpenCV).

     Детектор detect_h_marker (uav_perception) ищет ТЁМНУЮ букву «H» на
     СВЕТЛОМ фоне: OTSU-бинаризация + оценка формы (4 ножки по углам +
     перекладина в центре). Поэтому маркер = белая подложка + чёрная «H».

     Примечание: камера OakD-Lite в модели gz_x500_depth смотрит ВПЕРЁД,
     поэтому для детекции в полёте маркер должен попадать в поле зрения
     камеры (например, при взгляде вниз во время посадки). -->
<sdf version="1.9">
  <model name="h_marker">
    <static>true</static>
    <link name="link">

      <!-- Белая подложка 1x1 м (центр в начале координат, лежит на земле) -->
      <visual name="board">
        <geometry>
          <box>
            <size>1 1 0.01</size>
          </box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.95 0.95 0.95 1</diffuse>
        </material>
      </visual>
      <collision name="board_collision">
        <geometry>
          <box>
            <size>1 1 0.01</size>
          </box>
        </geometry>
      </collision>

      <!-- Левая ножка буквы H (тёмная) -->
      <visual name="leg_left">
        <pose>-0.29 0 0.012 0 0 0</pose>
        <geometry>
          <box>
            <size>0.14 0.66 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>

      <!-- Правая ножка буквы H (тёмная) -->
      <visual name="leg_right">
        <pose>0.29 0 0.012 0 0 0</pose>
        <geometry>
          <box>
            <size>0.14 0.66 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>

      <!-- Перекладина буквы H (тёмная) -->
      <visual name="crossbar">
        <pose>0 0 0.012 0 0 0</pose>
        <geometry>
          <box>
            <size>0.58 0.16 0.012</size>
          </box>
        </geometry>
        <material>
          <ambient>0.02 0.02 0.02 1</ambient>
          <diffuse>0.02 0.02 0.02 1</diffuse>
        </material>
      </visual>

    </link>
  </model>
</sdf>
