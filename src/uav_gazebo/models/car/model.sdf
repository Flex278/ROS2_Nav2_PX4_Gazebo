<?xml version="1.0" ?>
<!-- Низкополигональный седан (~4.5 x 1.8 x 1.3 м), цель для YOLO (класс car).
     Ниже плоскости полёта (2 м), поэтому в /scan не попадает — дрон на 2 м
     его перелетает; это CV-цель и визуальный «трафик». -->
<sdf version="1.9">
  <model name="car">
    <static>true</static>
    <link name="link">

      <!-- Нижний кузов -->
      <visual name="body_visual">
        <pose>0 0 0.6 0 0 0</pose>
        <geometry><box><size>4.5 1.8 0.55</size></box></geometry>
        <material>
          <ambient>0.5 0.05 0.05 1</ambient>
          <diffuse>0.8 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Кабина (тёмное «стекло») -->
      <visual name="cabin_visual">
        <pose>-0.2 0 1.05 0 0 0</pose>
        <geometry><box><size>2.2 1.6 0.5</size></box></geometry>
        <material>
          <ambient>0.06 0.08 0.10 1</ambient>
          <diffuse>0.10 0.14 0.18 1</diffuse>
        </material>
      </visual>

      <!-- 4 колеса (цилиндр, ось по Y -> roll 90°) -->
      <visual name="wheel_fl_visual">
        <pose>1.5 0.78 0.32 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>0.22</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="wheel_fr_visual">
        <pose>1.5 -0.78 0.32 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>0.22</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="wheel_rl_visual">
        <pose>-1.5 0.78 0.32 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>0.22</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>
      <visual name="wheel_rr_visual">
        <pose>-1.5 -0.78 0.32 1.5708 0 0</pose>
        <geometry><cylinder><radius>0.32</radius><length>0.22</length></cylinder></geometry>
        <material>
          <ambient>0.05 0.05 0.05 1</ambient>
          <diffuse>0.1 0.1 0.1 1</diffuse>
        </material>
      </visual>

      <!-- Общий collision (один бокс под габарит машины) -->
      <collision name="collision">
        <pose>0 0 0.7 0 0 0</pose>
        <geometry><box><size>4.5 1.8 1.4</size></box></geometry>
      </collision>

    </link>
  </model>
</sdf>
