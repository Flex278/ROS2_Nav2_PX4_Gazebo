<?xml version="1.0" ?>
<!-- Фонарный столб (5 м) — высокое препятствие.
     Пересекает горизонтальную плоскость полёта (2 м), поэтому попадает в /scan
     (центральная строка depth_to_scan) и Nav2 его обходит.
     Низкополи, сплошные цвета, без текстур (слабое железо). -->
<sdf version="1.9">
  <model name="street_light">
    <static>true</static>
    <link name="link">

      <!-- Столб: цилиндр 0 .. 5 м по Z -->
      <visual name="pole_visual">
        <pose>0 0 2.5 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>5.0</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>0.15 0.15 0.16 1</ambient>
          <diffuse>0.28 0.28 0.30 1</diffuse>
        </material>
      </visual>
      <collision name="pole_collision">
        <pose>0 0 2.5 0 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.1</radius>
            <length>5.0</length>
          </cylinder>
        </geometry>
      </collision>

      <!-- Плафон наверху -->
      <visual name="head_visual">
        <pose>0 0 5.0 0 0 0</pose>
        <geometry>
          <box>
            <size>0.5 0.3 0.15</size>
          </box>
        </geometry>
        <material>
          <ambient>0.7 0.7 0.5 1</ambient>
          <diffuse>0.85 0.85 0.65 1</diffuse>
          <emissive>0.3 0.3 0.15 1</emissive>
        </material>
      </visual>

    </link>
  </model>
</sdf>
