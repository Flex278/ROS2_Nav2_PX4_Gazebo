<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>uav_bringup</name>
  <version>0.1.0</version>
  <description>Launch-файлы верхнего уровня для полной симуляции UAV</description>
  <maintainer email="alex@example.com">Alex</maintainer>
  <license>MIT</license>

  <exec_depend>uav_sensors</exec_depend>
  <exec_depend>uav_offboard</exec_depend>
  <exec_depend>uav_perception</exec_depend>
  <exec_depend>uav_navigation</exec_depend>
  <exec_depend>uav_gazebo</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
